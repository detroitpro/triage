{
  "name": "triage",
  "version": "0.0.0",
  "private": true,
  "description": "Structured triage with TypeSafe Jev decisions and OpenRouter LLM fallbacks",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "triage": "tsx src/cli.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run && npm run test -w web",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "server": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.0.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "web"
  ]
}
