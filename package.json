{
  "name": "triage",
  "version": "0.0.0",
  "private": true,
  "description": "Structured triage with TypeSafe Jev decisions and OpenRouter LLM fallbacks",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "triage": "tsx src/cli.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run && npm run test -w web",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w web",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "web"
  ]
}
