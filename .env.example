OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=   (optional; without it Jev is reached through OpenRouter)
# Issue world target
TRIAGE_REPO=owner/repo
TRIAGE_REPO_PATH=/path/to/local/clone
# GITHUB_TOKEN=   (falls back to `gh auth token`)
# Optional overrides
# TYPESAFE_DEFAULT_MODEL=jev-latest
# OPENROUTER_MODEL=openai/gpt-4.1-mini   (openrouter/auto may pick a reasoning model that returns no content)
